<Activity mc:Ignorable="sap sap2010 sads"
         x:Class="Process"
         xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
         xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
         xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
         xmlns:ui="http://schemas.uipath.com/workflow/activities"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Sequence x:Name="Process_Sequence" DisplayName="Process Transaction"
            sap2010:WorkflowViewState.IdRef="Process_Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Object" Name="TransactionItem" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Traitement en cours"
                   Level="Info"
                   Message="Debut du traitement de la transaction"
                   sap2010:WorkflowViewState.IdRef="LogMessage_1" />

    <ui:LogMessage DisplayName="Traitement termine"
                   Level="Info"
                   Message="Transaction traitee avec succes"
                   sap2010:WorkflowViewState.IdRef="LogMessage_2" />
  </Sequence>
</Activity>
