<Activity mc:Ignorable="sap sap2010 sads"
         x:Class="GetTransactionData"
         xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
         xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
         xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
         xmlns:ui="http://schemas.uipath.com/workflow/activities"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Sequence x:Name="GetTransactionData_Sequence" DisplayName="Get Transaction Data"
            sap2010:WorkflowViewState.IdRef="GetTransactionData_Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Object" Name="TransactionItem" />
      <Variable x:TypeArguments="x:Boolean" Name="HasMoreTransactions" Default="True" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Recuperation transaction"
                   Level="Info"
                   Message="Recherche de la prochaine transaction..."
                   sap2010:WorkflowViewState.IdRef="LogMessage_1" />

    <ui:LogMessage DisplayName="Transaction obtenue"
                   Level="Info"
                   Message="[String.Format("Transaction recuperee: {0}", TransactionItem)]"
                   sap2010:WorkflowViewState.IdRef="LogMessage_2" />
  </Sequence>
</Activity>
