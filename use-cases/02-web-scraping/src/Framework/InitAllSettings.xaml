<Activity mc:Ignorable="sap sap2010 sads" x:Class="InitAllSettings"
         xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
         xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
         xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
         xmlns:ui="http://schemas.uipath.com/workflow/activities"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Sequence x:Name="Init_Sequence" DisplayName="Init - Charge Config, verifie URL">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="TargetURL" />
      <Variable x:TypeArguments="x:String" Name="OutputFile" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Init"
                   Level="Info"
                   Message="Log message" />
  </Sequence>
</Activity>
