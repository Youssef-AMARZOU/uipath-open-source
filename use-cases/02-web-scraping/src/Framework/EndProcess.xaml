<Activity mc:Ignorable="sap sap2010 sads" x:Class="EndProcess"
         xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
         xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
         xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
         xmlns:ui="http://schemas.uipath.com/workflow/activities"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Sequence x:Name="EndProcess_Sequence" DisplayName="EndProcess - Resume">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Int32" Name="RowsExtracted" />
      <Variable x:TypeArguments="x:Int32" Name="RowsSkipped" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="EndProcess"
                   Level="Info"
                   Message="[String.Format(\"Lignes extraites: {0} | Ignorees: {1}\", RowsExtracted, RowsSkipped)]" />
  </Sequence>
</Activity>
