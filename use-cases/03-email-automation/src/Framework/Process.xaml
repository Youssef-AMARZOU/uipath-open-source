<Activity mc:Ignorable="sap sap2010 sads" x:Class="Process"
         xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
         xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
         xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
         xmlns:ui="http://schemas.uipath.com/workflow/activities"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Sequence x:Name="Process_Sequence" DisplayName="Process - Classification + Reponse auto">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="EmailSubject" />
      <Variable x:TypeArguments="x:String" Name="EmailSender" />
      <Variable x:TypeArguments="x:String" Name="Classification" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Process"
                   Level="Info"
                   Message="Classification et traitement de l'e-mail..." />
  </Sequence>
</Activity>
